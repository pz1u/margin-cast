# 기상청 API허브에서 발급받은 인증키를 입력합니다.
KMA_SERVICE_KEY=
# auto는 키 형식으로 공공데이터포털과 기상청 API허브를 구분합니다.
KMA_API_PROVIDER=auto
# 카카오 로컬 REST API에서 발급받은 서버용 키를 입력합니다.
KAKAO_REST_API_KEY=
# Ollama Chat API 서버와 Tool Calling을 지원하는 로컬 모델을 지정합니다.
# G단계 로컬 개발 후보는 qwen3:1.7b이며 qwen3:4b도 계속 지원합니다.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# 실제 Ollama 선택 테스트를 실행할 때만 1로 설정합니다.
RUN_OLLAMA_INTEGRATION=0
# LLM Provider 선택. 비어 있으면 기존 로컬 개발 기본값인 ollama를 사용합니다.
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=
# 실제 OpenAI 선택 테스트를 실행할 때만 1로 설정합니다.
RUN_OPENAI_INTEGRATION=0

# 배포 환경. HOST=0.0.0.0과 플랫폼이 주는 PORT를 사용합니다.
HOST=127.0.0.1
PORT=8000
# 감사·피드백·매장 설정 JSON을 저장할 쓰기 가능한 경로입니다.
MARGINCAST_STATE_DIR=
